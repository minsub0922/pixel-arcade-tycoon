# ── Pixel Arcade Tycoon 환경 변수 ─────────────────────────────
# 이 파일을 복사해 .env 를 만들고 값을 채우세요. .env 는 절대 커밋되지 않습니다(.gitignore).
# 아무것도 설정하지 않아도 게임은 사전 생성 풀(pool 모드)로 완전 동작합니다.

# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료 발급)
# 용도 ① scripts/pregen.mjs (콘텐츠 풀 재생성, 빌드 타임)
# 용도 ② 로컬 dev 서버의 direct 모드 (브라우저에서 직접 호출 — dev 전용, 프로덕션 번들에는 절대 포함되지 않음)
GEMINI_API_KEY=

# Cloudflare Workers 프록시 URL (배포 방법: cloudflare/DEPLOY.md)
# 설정 시 배포 빌드가 라이브 LLM(proxy 모드)을 사용. 예: https://pixel-arcade-llm.<계정>.workers.dev
VITE_LLM_PROXY_URL=

# Gemini 모델명 (기본값을 바꿀 때만 설정. 프록시 쪽은 wrangler vars 로 별도 관리)
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
